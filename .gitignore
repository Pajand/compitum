# Build output
/target
**/target/

# Rust incremental and profiling artefacts
*.profraw
*.profdata

# Python bytecode from the repository's dependency-free tooling in tools/.
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Generated assessment reports. Useful to look at, but they are build output: 170 KB
# each, regenerated in seconds, so they would be noise in the history.
/samples/

# Local scratch space for the Oracle ledger and scratch binaries during development.
# Committed fixtures live under tests/corpus and are deliberately NOT ignored.
/oracle-data/
/scratch/
*.exe.bak

# Never commit secrets. Namespace tokens are injected as environment variables at
# publish time; see SECURITY.md.
.npmrc
*.pem
*.key
